  "name": "zero-to-sys",
  "version": "1.15.0",
  "description": "Skills e agentes em português para criar um sistema do zero até produção, com orquestrador paralelo e especialistas por área.",
  "author": {
    "name": "BlackRed Solutions",
    "url": "https://github.com/BlackRedSolutionsTeam"
  },
  "homepage": "https://github.com/BlackRedSolutionsTeam/zero-to-sys",
  "repository": "https://github.com/BlackRedSolutionsTeam/zero-to-sys",
  "license": "MIT",
  "keywords": [
    "skills",
    "agents",
    "pt-br",
    "architecture",
    "stack",
    "security",
    "infra",
    "design-system",
    "mobile-release",
    "desktop-release"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "zero-to-sys",
        "category": "Coding",
        "defaultPrompt": "Cria um sistema do zero com o zero-to-sys"
      }
    }
  }
}
